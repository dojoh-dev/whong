{
  "version": "0.0.0",
  "name": "whong",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">= 22.x",
    "pnpm": ">= 8.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node esbuild.config.mjs",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "format": "prettier --write '**/*.ts'",
    "lint": "eslint . --fix --ext .ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@types/node": "^25.6.0",
    "discord.js": "^14.26.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-raw-body": "^5.0.0",
    "octokit": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.4.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  }
}
