{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",

		"strict": true,
		"noImplicitAny": true,
		"esModuleInterop": true,
		"allowJs": false,

		"ignoreDeprecations": "6.0",

		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
		},
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"],
}
