{
  "semi": true,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "bracketSpacing": true,
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": [
    "<BUILTIN_MODULES>",
    "^discord\\.js",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/",
    "^[.]",
    "",
    "<TYPES>"
  ]
}
